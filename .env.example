# Neon pooled runtime connection string.
# Example: postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/DB?sslmode=require&channel_binding=require
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/DB?sslmode=require&channel_binding=require"

# Neon direct connection string for Prisma migrations.
# Example: postgresql://USER:PASSWORD@HOST.REGION.aws.neon.tech/DB?sslmode=require
DIRECT_URL="postgresql://USER:PASSWORD@HOST.REGION.aws.neon.tech/DB?sslmode=require"

NEXT_PUBLIC_ADMIN_PANEL_PREFIX="system-control"
NEXT_PUBLIC_ADMIN_LOGIN_PATH="auth-login"
JWT_SECRET="replace-with-a-long-random-secret"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
ADMIN_EMAIL=""
ADMIN_PASSWORD=""

# Newsletter notifications. Values can also be managed from the admin Settings page.
TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHAT_ID=""
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
NEWSLETTER_WELCOME_ENABLED="true"
ADMIN_NOTIFY_NEWSLETTER_ENABLED="true"

# Optional live-server auth integration tests.
# Set RUN_AUTH_INTEGRATION_TESTS="true" and provide test admin credentials only when intentionally running them.
RUN_AUTH_INTEGRATION_TESTS="false"
TEST_BASE_URL="http://localhost:3000"
TEST_ADMIN_EMAIL=""
TEST_ADMIN_PASSWORD=""

NEXT_PUBLIC_VIETQR_BANK_ID=""
NEXT_PUBLIC_VIETQR_ACCOUNT_NO=""
NEXT_PUBLIC_VIETQR_ACCOUNT_NAME=""
SEPAY_API_KEY=""
SEPAY_API_URL="https://api.sepay.vn"
PAYOS_CLIENT_ID=""
PAYOS_API_KEY=""
PAYOS_CHECKSUM_KEY=""
NEXT_PUBLIC_MOMO_PHONE=""
NEXT_PUBLIC_MOMO_RECEIVER_NAME=""
